// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ROHI SYSTEMS — business enquiries submitted via the Contact section.
model Enquiry {
  id                String   @id @default(cuid())
  name              String
  company           String?
  email             String
  phone             String?
  whatNeeded        String?
  improving         String?
  currentProcess    String?
  currentTech       String?
  successLooksLike  String?
  budgetRange       String?
  preferredContact  String?
  createdAt         DateTime @default(now())
}

// Newsletter subscribers (Insights page).
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

// Chatbot conversation transcripts saved on handoff to /contact.
model ChatTranscript {
  id          String   @id @default(cuid())
  sessionId   String?
  summary     String?
  transcript  String   // full JSON of messages
  createdAt   DateTime @default(now())
}

// Lightweight, privacy-friendly analytics events (no PII, no cookies).
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  page      String?
  payload   String?
  createdAt DateTime @default(now())
}

// Self-assessment submissions (the "How ready is your organization?" quiz).
model Assessment {
  id        String   @id @default(cuid())
  email     String?
  answers   String   // JSON: array of {questionId, score, label}
  score     Int
  stage     String
  createdAt DateTime @default(now())
}

