# ROHI SYSTEMS — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Database (SQLite, local) ---
DATABASE_URL="file:./db/custom.db"

# --- AI Chatbot ---
# The chat assistant uses the platform-managed z-ai-web-dev-sdk (no API key
# required). The /api/chat route is pre-authenticated by the runtime.
# OPENROUTER_API_KEY / OPENROUTER_MODEL are NOT used anymore.

# --- Email notifications (Resend) ---
# Get a free API key at https://resend.com (100 emails/day free)
RESEND_API_KEY=""
# The email address to receive team notifications (your email)
TEAM_EMAIL="your-email@example.com"
# Optional: the "from" address (on free tier without a verified domain, leave as default)
# RESEND_FROM="ROHI SYSTEMS <onboarding@resend.dev>"
