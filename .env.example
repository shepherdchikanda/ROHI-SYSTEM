# ROHI SYSTEMS — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Database (SQLite, local) ---
DATABASE_URL="file:./db/custom.db"

# --- AI Chatbot (OpenRouter) ---
# Get a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key-here"

# Optional: override the model (defaults to the free XingChen model)
# Browse models at https://openrouter.ai/models
OPENROUTER_MODEL="xingchen-agi/xing4.0-29b-a4b:free"

# --- Email notifications (Resend) ---
# Get a free API key at https://resend.com (100 emails/day free)
RESEND_API_KEY=""
# The email address to receive team notifications (your email)
TEAM_EMAIL="your-email@example.com"
# Optional: the "from" address (on free tier without a verified domain, leave as default)
# RESEND_FROM="ROHI SYSTEMS <onboarding@resend.dev>"
